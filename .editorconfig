root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[CMakeLists.txt]
indent_style = tab
indent_size = 4
tab_width = 4
end_of_line = lf

[build.ps1]
indent_style = tab
indent_size = 4
tab_width = 4
end_of_line = crlf
